# For docker compose (repository root). Copy to .env (never committed) and fill in the secrets.
# Make each secret with:  python3 -c "import secrets; print(secrets.token_hex(32))"

# PostgreSQL password. It goes into a URL: use letters and digits only (token_hex output is fine).
POSTGRES_PASSWORD=

# Required. Keep these the same for the life of the database: a new JWT secret logs everyone out,
# and a new encryption key makes the encrypted health notes unreadable. Back up the encryption key
# together with the database (README "Backup and restore").
NUTRISENSE_JWT_SECRET=
NUTRISENSE_ENCRYPTION_KEY=

# Local try-out with demo accounts (public password). Remove both lines before entering real data.
NUTRISENSE_SEED_DEMO_DATA=true
NUTRISENSE_ALLOW_DEMO=1

# Browser origins allowed to call the API from another address (the built-in web app needs none).
NUTRISENSE_CORS_ORIGINS=http://localhost:8000

# Optional: a Claude API key turns on photo NutriScan and free-form Tanya Nuri.
NUTRISENSE_ANTHROPIC_API_KEY=
