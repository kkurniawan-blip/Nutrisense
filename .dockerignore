# Keep the build context small and free of secrets and local data.
**/node_modules
**/.venv
**/__pycache__
**/.pytest_cache
**/.expo
**/dist
**/web-build

# Secrets and local settings (the image gets its settings from env vars at run time)
.env
.env.*
!.env.example
**/.env
backend/.env*
mobile/.env*
!mobile/.env.example

# Local runtime data
backend/*.db
backend/*.db-*
backend/model_store
backend/uploads
backend/backups
backend/web
backend/web.new

# Not needed in the image
e2e
docs
.git
.github
.devcontainer
.claude
