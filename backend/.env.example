# Copy to backend/.env and adjust. Every variable is optional for local development.

# Claude API key: enables AI symptom understanding, NutriScan photo analysis, personalised
# nutrition plans and the NutriBot assistant. Without it, the rule-based / scikit-learn AI is used.
NUTRISENSE_ANTHROPIC_API_KEY=
NUTRISENSE_AI_MODEL=claude-opus-5

# Database: SQLite by default. For PostgreSQL:
# NUTRISENSE_DATABASE_URL=postgresql+psycopg2://nutrisense:nutrisense@localhost:5432/nutrisense

# REQUIRED in production: long random secrets.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NUTRISENSE_JWT_SECRET=change-me
NUTRISENSE_ENCRYPTION_KEY=

NUTRISENSE_ENVIRONMENT=development
NUTRISENSE_SEED_DEMO_DATA=true
NUTRISENSE_CORS_ORIGINS=*
